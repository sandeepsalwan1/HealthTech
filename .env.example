# HealthTech example environment
# Copy to .env and fill in values as needed

# API keys
OPENAI_API_KEY=
TAVILY_API_KEY=

# App
APP_NAME=HealthTech
APP_ALLOW_DEMO_LOGIN=true

# Networking
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:8501

# Agents
AGENT_THREAD_ID=demo-thread

# Logging
LOG_LEVEL=info